# OERSI metadata search endpoint (documented official endpoint)
OERSI_API_URL=https://oersi.org/api/search/oer_data/_search

# Configure an identifiable User-Agent before regular use; avoid personal data in this template.
OERSI_USER_AGENT="OERSI-Resource-Repository/0.1 (metadata-only extraction)"

# Extraction limits and network timeout
OERSI_LIMIT=100
OERSI_SAMPLE_SIZE=20
OERSI_TARGET_PER_CATEGORY=10
OERSI_TIMEOUT=20
OERSI_OUTPUT_DIR=data
