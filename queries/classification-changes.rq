PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?resource ?versionNumber ?previous ?version ?from ?to WHERE {
  ?resource dcterms:hasVersion ?version .
  ?version repo:versionNumber ?versionNumber ; prov:wasRevisionOf ?previous ;
           repo:classification/dcterms:identifier ?to .
  ?previous repo:classification/dcterms:identifier ?from .
  FILTER (?from != ?to)
}
ORDER BY ?resource ?versionNumber
