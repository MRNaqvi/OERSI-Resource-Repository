# Optionally bind ?resource for a single history.
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?resource ?versionNumber ?version ?graph ?isCurrent WHERE {
  ?resource dcterms:hasVersion ?version .
  ?version repo:versionNumber ?versionNumber ; repo:graphIRI ?graph ; repo:isCurrent ?isCurrent .
}
ORDER BY ?resource ?versionNumber
