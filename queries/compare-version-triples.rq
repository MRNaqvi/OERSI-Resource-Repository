# Compares ground triples in the primary graphs. Bind optional version numbers.
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?resource ?change ?subject ?predicate ?object WHERE {
  BIND(COALESCE(?fromVersion, 1) AS ?fromNumber)
  BIND(COALESCE(?toVersion, 2) AS ?toNumber)
  ?resource dcterms:hasVersion ?beforeVersion, ?afterVersion .
  ?beforeVersion repo:versionNumber ?fromNumber ; repo:graphIRI ?before .
  ?afterVersion repo:versionNumber ?toNumber ; repo:graphIRI ?after .
  VALUES ?change { "added" "removed" }
  BIND(IF(?change = "added", ?after, ?before) AS ?target)
  BIND(IF(?change = "added", ?before, ?after) AS ?other)
  GRAPH ?target { ?subject ?predicate ?object }
  FILTER NOT EXISTS { GRAPH ?other { ?subject ?predicate ?object } }
  FILTER (!isBlank(?subject) && !isBlank(?object))
}
ORDER BY ?resource ?change ?subject ?predicate ?object
