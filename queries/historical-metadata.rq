# Bind ?resource and either ?versionNumber or ?version.
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?resource ?versionNumber ?version ?graph ?subject ?predicate ?object WHERE {
  ?resource dcterms:hasVersion ?version .
  ?version repo:versionNumber ?versionNumber ; (repo:graphIRI|repo:sourceGraph) ?graph .
  GRAPH ?graph { ?subject ?predicate ?object }
}
ORDER BY ?resource ?versionNumber ?graph ?subject ?predicate ?object
