# The CLI supplies the configured repo: prefix.
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?resource ?title ?version WHERE {
  ?container a repo:Container ; dcterms:identifier "learning_materials" .
  ?resource dcterms:isPartOf ?container ; repo:currentVersion ?version .
  OPTIONAL { ?resource dcterms:title ?title . }
}
ORDER BY ?resource
